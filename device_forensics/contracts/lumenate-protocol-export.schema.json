{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/lumenate-nova/contracts/lumenate-protocol-export-0.1.0.schema.json",
  "title": "Lumenate Nova Protocol Export",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "ave_evidence_schema_version",
    "export_id",
    "created_at",
    "device",
    "session",
    "segments",
    "commands",
    "sync_anchors",
    "provenance",
    "confidence",
    "limitations",
    "ave_evidence"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "ave_evidence_schema_version": {"const": "1.0.0"},
    "export_id": {"type": "string", "pattern": "^ln_[0-9a-f]{16}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product", "app_package", "app_version", "app_version_code", "firmware_version"],
      "properties": {
        "product": {"const": "Lumenate Nova"},
        "app_package": {"type": "string", "minLength": 1},
        "app_version": {"type": "string", "minLength": 1},
        "app_version_code": {"type": "integer", "minimum": 0},
        "firmware_version": {"type": ["string", "null"]}
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session_id", "duration_ms"],
      "properties": {
        "session_id": {"type": "string", "minLength": 1},
        "title": {"type": ["string", "null"]},
        "duration_ms": {"type": "integer", "minimum": 0}
      }
    },
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["segment_id", "start_ms", "end_ms", "intensity", "color_rgb", "pulse", "command_ids", "evidence_ids"],
        "properties": {
          "segment_id": {"type": "string", "minLength": 1},
          "start_ms": {"type": "integer", "minimum": 0},
          "end_ms": {"type": "integer", "minimum": 0},
          "intensity": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
          "color_rgb": {
            "oneOf": [
              {"type": "null"},
              {"type": "array", "prefixItems": [{"type": "integer", "minimum": 0, "maximum": 255}, {"type": "integer", "minimum": 0, "maximum": 255}, {"type": "integer", "minimum": 0, "maximum": 255}], "items": false}
            ]
          },
          "pulse": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "properties": {
              "frequency_hz": {"type": ["number", "null"], "exclusiveMinimum": 0},
              "duty_cycle": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
              "on_ms": {"type": ["number", "null"], "minimum": 0},
              "off_ms": {"type": ["number", "null"], "minimum": 0}
            }
          },
          "command_ids": {"type": "array", "items": {"type": "string"}},
          "evidence_ids": {"type": "array", "items": {"type": "string", "pattern": "^ave_[0-9a-f]{16}$"}}
        }
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command_id", "time_ms", "direction", "service_uuid", "characteristic_uuid", "payload_hex", "interpretation", "evidence_ids"],
        "properties": {
          "command_id": {"type": "string", "minLength": 1},
          "time_ms": {"type": "integer", "minimum": 0},
          "direction": {"enum": ["app_to_device", "device_to_app"]},
          "service_uuid": {"type": ["string", "null"]},
          "characteristic_uuid": {"type": "string", "minLength": 1},
          "payload_hex": {"type": ["string", "null"], "pattern": "^(?:[0-9a-fA-F]{2})*$"},
          "interpretation": {"type": ["string", "null"]},
          "evidence_ids": {"type": "array", "items": {"type": "string", "pattern": "^ave_[0-9a-f]{16}$"}}
        }
      }
    },
    "sync_anchors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["anchor_id", "source_clock", "source_time_ms", "session_time_ms", "uncertainty_ms", "evidence_ids"],
        "properties": {
          "anchor_id": {"type": "string", "minLength": 1},
          "source_clock": {"type": "string", "minLength": 1},
          "source_time_ms": {"type": "number"},
          "session_time_ms": {"type": "number", "minimum": 0},
          "uncertainty_ms": {"type": "number", "minimum": 0},
          "evidence_ids": {"type": "array", "items": {"type": "string", "pattern": "^ave_[0-9a-f]{16}$"}}
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_hashes", "acquisition_notes"],
      "properties": {
        "source_hashes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source_id", "sha256"],
            "properties": {
              "source_id": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        },
        "acquisition_notes": {"type": "array", "items": {"type": "string"}}
      }
    },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "score", "method"],
      "properties": {
        "level": {"enum": ["L1", "L2", "L3", "L4", "L5"]},
        "score": {"type": "number", "minimum": 0, "maximum": 1},
        "method": {"type": "string", "minLength": 1}
      }
    },
    "limitations": {"type": "array", "items": {"type": "string"}},
    "ave_evidence": {
      "type": "array",
      "items": {"$ref": "ave-evidence-object-1.0.0.schema.json"}
    }
  }
}
