{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/lumenate-nova/contracts/lumenate-protocol-export-0.2.0.schema.json",
  "title": "Lumenate Nova Protocol Export",
  "description": "Released 0.2.0 producer contract for evidence-backed light timelines and AVE synchronization.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "ave_evidence_schema_version", "export_id", "created_at", "device", "session", "audio_asset", "clocks", "segments", "transitions", "commands", "sync_anchors", "provenance", "confidence", "limitations", "ave_evidence"],
  "$defs": {
    "evidence_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^ave_[0-9a-f]{16}$"}
    },
    "execution_layer": {
      "enum": ["session_declaration", "app", "native_engine", "ble_transport", "firmware", "physical_measurement", "unknown"]
    },
    "timeline_origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clock_id", "time_ms", "definition", "evidence_ids"],
      "properties": {
        "clock_id": {"type": "string", "minLength": 1},
        "time_ms": {"type": "number"},
        "definition": {"type": "string", "minLength": 1},
        "evidence_ids": {"$ref": "#/$defs/evidence_ids"}
      }
    }
  },
  "properties": {
    "schema_version": {"const": "0.2.0"},
    "ave_evidence_schema_version": {"const": "1.0.0"},
    "export_id": {"type": "string", "pattern": "^ln_[0-9a-f]{16}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product", "app_package", "app_version", "app_version_code", "firmware_version"],
      "properties": {
        "product": {"const": "Lumenate Nova"},
        "app_package": {"type": "string", "minLength": 1},
        "app_version": {"type": "string", "minLength": 1},
        "app_version_code": {"type": "integer", "minimum": 0},
        "firmware_version": {"type": ["string", "null"]}
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session_id", "title", "duration_ms", "light_timeline_origin", "audio_timeline_origin"],
      "properties": {
        "session_id": {"type": "string", "minLength": 1},
        "title": {"type": ["string", "null"]},
        "duration_ms": {"type": "integer", "minimum": 0},
        "light_timeline_origin": {"$ref": "#/$defs/timeline_origin"},
        "audio_timeline_origin": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/timeline_origin"}]}
      }
    },
    "audio_asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity_status", "source_id", "role", "sha256", "duration_ms", "sample_rate_hz", "limitations"],
      "properties": {
        "identity_status": {"enum": ["verified", "unavailable", "unknown"]},
        "source_id": {"type": ["string", "null"], "minLength": 1},
        "role": {"type": ["string", "null"], "minLength": 1},
        "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "duration_ms": {"type": ["number", "null"], "minimum": 0},
        "sample_rate_hz": {"type": ["integer", "null"], "exclusiveMinimum": 0},
        "limitations": {"type": "array", "items": {"type": "string"}}
      },
      "allOf": [
        {
          "if": {"properties": {"identity_status": {"const": "verified"}}, "required": ["identity_status"]},
          "then": {"properties": {
            "source_id": {"type": "string", "minLength": 1},
            "role": {"type": "string", "minLength": 1},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }},
          "else": {"properties": {"limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}}}}
        }
      ]
    },
    "clocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["clock_id", "kind", "monotonic", "unit", "origin", "resolution_ms", "evidence_ids"],
        "properties": {
          "clock_id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["monotonic", "wall_clock", "media_position", "ble_capture", "app_callback", "optical_measurement"]},
          "monotonic": {"type": "boolean"},
          "unit": {"const": "ms"},
          "origin": {"type": ["string", "null"]},
          "resolution_ms": {"type": ["number", "null"], "exclusiveMinimum": 0},
          "evidence_ids": {"$ref": "#/$defs/evidence_ids"}
        }
      }
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["segment_id", "start_ms", "end_ms", "execution_layer", "intensity", "color_rgb", "pulse", "overlap_with_segment_ids", "command_ids", "evidence_ids"],
        "properties": {
          "segment_id": {"type": "string", "minLength": 1},
          "start_ms": {"type": "integer", "minimum": 0},
          "end_ms": {"type": "integer", "minimum": 0},
          "execution_layer": {"$ref": "#/$defs/execution_layer"},
          "intensity": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
          "color_rgb": {"oneOf": [
            {"type": "null"},
            {"type": "array", "prefixItems": [{"type": "integer", "minimum": 0, "maximum": 255}, {"type": "integer", "minimum": 0, "maximum": 255}, {"type": "integer", "minimum": 0, "maximum": 255}], "items": false}
          ]},
          "pulse": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["frequency_hz", "duty_cycle", "on_ms", "off_ms", "shape", "shape_detail"],
            "properties": {
              "frequency_hz": {"type": ["number", "null"], "exclusiveMinimum": 0},
              "duty_cycle": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
              "on_ms": {"type": ["number", "null"], "minimum": 0},
              "off_ms": {"type": ["number", "null"], "minimum": 0},
              "shape": {"enum": ["square", "smoothed", "ramped", "interpolated", "unknown", "other"]},
              "shape_detail": {"type": ["string", "null"]}
            },
            "allOf": [{
              "if": {"properties": {"shape": {"const": "other"}}, "required": ["shape"]},
              "then": {"properties": {"shape_detail": {"type": "string", "minLength": 1}}}
            }]
          },
          "overlap_with_segment_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "command_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "evidence_ids": {"$ref": "#/$defs/evidence_ids"}
        }
      }
    },
    "transitions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["transition_id", "type", "start_ms", "end_ms", "from_segment_id", "to_segment_id", "execution_layer", "parameters", "evidence_ids"],
        "properties": {
          "transition_id": {"type": "string", "minLength": 1},
          "type": {"enum": ["step", "ramp", "interpolation", "pause", "resumption", "discontinuity", "unknown"]},
          "start_ms": {"type": "integer", "minimum": 0},
          "end_ms": {"type": "integer", "minimum": 0},
          "from_segment_id": {"type": ["string", "null"], "minLength": 1},
          "to_segment_id": {"type": ["string", "null"], "minLength": 1},
          "execution_layer": {"$ref": "#/$defs/execution_layer"},
          "parameters": {"type": ["object", "null"]},
          "evidence_ids": {"$ref": "#/$defs/evidence_ids"}
        }
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command_id", "clock_id", "time_ms", "direction", "execution_layer", "service_uuid", "characteristic_uuid", "payload_hex", "interpretation", "evidence_ids"],
        "properties": {
          "command_id": {"type": "string", "minLength": 1},
          "clock_id": {"type": "string", "minLength": 1},
          "time_ms": {"type": "number"},
          "direction": {"enum": ["app_to_device", "device_to_app"]},
          "execution_layer": {"$ref": "#/$defs/execution_layer"},
          "service_uuid": {"type": ["string", "null"]},
          "characteristic_uuid": {"type": "string", "minLength": 1},
          "payload_hex": {"type": ["string", "null"], "pattern": "^(?:[0-9a-fA-F]{2})*$"},
          "interpretation": {"type": ["string", "null"]},
          "evidence_ids": {"$ref": "#/$defs/evidence_ids"}
        }
      }
    },
    "sync_anchors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["anchor_id", "from_clock_id", "from_time_ms", "to_clock_id", "to_time_ms", "uncertainty_ms", "method", "evidence_ids"],
        "properties": {
          "anchor_id": {"type": "string", "minLength": 1},
          "from_clock_id": {"type": "string", "minLength": 1},
          "from_time_ms": {"type": "number"},
          "to_clock_id": {"type": "string", "minLength": 1},
          "to_time_ms": {"type": "number"},
          "uncertainty_ms": {"type": "number", "minimum": 0},
          "method": {"type": "string", "minLength": 1},
          "evidence_ids": {"$ref": "#/$defs/evidence_ids"}
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_hashes", "acquisition_notes"],
      "properties": {
        "source_hashes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source_id", "sha256"],
            "properties": {
              "source_id": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        },
        "acquisition_notes": {"type": "array", "items": {"type": "string"}}
      }
    },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "score", "method"],
      "properties": {
        "level": {"enum": ["L1", "L2", "L3", "L4", "L5"]},
        "score": {"type": "number", "minimum": 0, "maximum": 1},
        "method": {"type": "string", "minLength": 1}
      }
    },
    "limitations": {"type": "array", "items": {"type": "string"}},
    "ave_evidence": {"type": "array", "minItems": 1, "items": {"$ref": "ave-evidence-object-1.0.0.schema.json"}}
  }
}
