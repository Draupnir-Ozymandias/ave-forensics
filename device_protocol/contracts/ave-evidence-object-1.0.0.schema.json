{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Draupnir-Ozymandias/ave-forensics/blob/main/evidence/evidence-object.schema.json",
  "title": "AVE Forensics Evidence Object",
  "description": "Canonical portable evidence produced by AVE analyzers.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_id",
    "evidence_level",
    "evidence_type",
    "source_module",
    "summary",
    "scope",
    "measurements",
    "context",
    "confidence",
    "provenance",
    "supporting_evidence_ids",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "evidence_id": {"type": "string", "pattern": "^ave_[0-9a-f]{16}$"},
    "evidence_level": {
      "enum": ["measurement", "detection", "association", "reconstruction", "hypothesis"]
    },
    "evidence_type": {"type": "string", "minLength": 1},
    "source_module": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channels", "time_range_seconds"],
      "properties": {
        "channels": {"type": "array", "items": {"type": "string"}},
        "time_range_seconds": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["start", "end"],
              "properties": {
                "start": {"type": "number", "minimum": 0},
                "end": {"type": "number", "minimum": 0}
              }
            }
          ]
        }
      }
    },
    "measurements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "value", "unit"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "value": {},
          "unit": {"type": "string", "minLength": 1}
        }
      }
    },
    "context": {"type": "object"},
    "confidence": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": true,
          "required": ["score", "method"],
          "properties": {
            "score": {"type": "number", "minimum": 0, "maximum": 1},
            "method": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "provenance": {"type": "object"},
    "supporting_evidence_ids": {
      "type": "array",
      "items": {"type": "string", "pattern": "^ave_[0-9a-f]{16}$"}
    },
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}
