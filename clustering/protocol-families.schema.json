{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ave-forensics.local/schemas/protocol-families-1.0.0.json",
  "title": "AVE Protocol Families",
  "type": "object",
  "required": [
    "clustering_schema_version",
    "source_index_schema_version",
    "source_index_sha256",
    "method",
    "feature_specification",
    "clustered_unique_input_count",
    "excluded_recordings",
    "families",
    "assignments"
  ],
  "properties": {
    "clustering_schema_version": {"const": "1.0.0"},
    "source_index_schema_version": {"type": ["string", "null"]},
    "source_index_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "method": {"type": "object"},
    "feature_specification": {"type": "object"},
    "clustered_unique_input_count": {"type": "integer", "minimum": 1},
    "excluded_recordings": {"type": "array"},
    "families": {"type": "array", "minItems": 1},
    "assignments": {"type": "array", "minItems": 1}
  },
  "additionalProperties": false
}
