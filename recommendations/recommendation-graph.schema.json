{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ave-forensics.local/schemas/recommendation-graph-1.0.0.json",
  "title": "AVE Provider Recommendation Graph",
  "type": "object",
  "required": ["recommendation_graph_schema_version", "provider", "source_observations", "summary", "nodes", "edges", "seed_list_variants", "interpretation"],
  "properties": {
    "recommendation_graph_schema_version": {"const": "1.0.0"},
    "provider": {"const": "brain.fm"},
    "source_observations": {"type": "array", "minItems": 1},
    "summary": {"type": "object"},
    "nodes": {"type": "array"},
    "edges": {"type": "array"},
    "seed_list_variants": {"type": "array"},
    "interpretation": {"type": "object"}
  },
  "additionalProperties": false
}
